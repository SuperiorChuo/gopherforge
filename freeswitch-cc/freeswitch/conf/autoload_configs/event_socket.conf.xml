<configuration name="event_socket.conf" description="Socket Client">
  <settings>
    <!-- 开发：监听全接口；生产请改为内网 IP 并改密码 -->
    <param name="nat-map" value="false"/>
    <param name="listen-ip" value="0.0.0.0"/>
    <param name="listen-port" value="8021"/>
    <param name="password" value="ClueCon"/>
    <!-- mod_event_socket 1.10.7+ 不配 ACL 会默认套 loopback.auto，没有"仅密码"
         模式；esl-trusted（见 acl.conf.xml）= 回环 + RFC1918，容器内 fs_cli 与
         docker 网桥都放行。生产按 docs/deploy-and-debug.md 改密码并收窄网段。 -->
    <param name="apply-inbound-acl" value="esl-trusted"/>
  </settings>
</configuration>
