# control-api
# 容器内固定监听 8090；宿主机映射端口用 CC_API_HOST_PORT 调
# 如果 8090 已被占用，请选择其他空闲端口。
CC_API_HOST_PORT=8090
CC_API_TOKEN=dev-cc-token-change-me
# bridge 模式（默认，macOS）连容器名；hostnet 模式（Linux，
# docker compose up -d postgres control-api freeswitch-host）
# 改为 host.docker.internal
CC_ESL_HOST=freeswitch
CC_ESL_PORT=8021
CC_ESL_PASSWORD=ClueCon

# PostgreSQL (control-api CDR)
POSTGRES_USER=fscc
POSTGRES_PASSWORD=fscc123
POSTGRES_DB=fs_cc
POSTGRES_PORT=5434

# Webhook → Go Admin Kit cc-adapter (FS-M2+)
# Example: http://host.docker.internal:8081/api/v1/cc/webhook
CC_WEBHOOK_URL=
CC_WEBHOOK_SECRET=dev-webhook-secret-change-me

# 可选中台集成，默认关闭；填写 FreeSWITCH/control-api 可达的中台网关 URL。
# 不同 Compose project 的 localhost 不是宿主机，也不是另一栈的服务。
# CC_CID_URL=https://gateway.example.com/api/v1/cc/cid
# CC_RISK_URL=https://gateway.example.com/api/v1/cc/internal/risk-check
# CC_EARLY_MEDIA_URL=https://gateway.example.com/api/v1/cc/internal/early-media/classify
CC_CID_URL=
CC_RISK_URL=
CC_EARLY_MEDIA_URL=

# mod_xml_curl 动态目录：FS 每次 directory 查询 HTTP POST 问 control-api（SIP
# 密码不落盘、改分机即时生效、失败回退磁盘文件）。默认值已在 compose 里给到位，
# 一般无需覆盖；若要显式指定，两种网络形态：
#   bridge（默认，macOS）—— 走 control-api 服务名 :8090
#     CC_XML_CURL_URL=http://fs:dev-cc-token-change-me@control-api:8090/v1/fs-xml
#   hostnet（Linux，freeswitch-host）—— 走宿主机 127.0.0.1:CC_API_HOST_PORT
#     CC_XML_CURL_URL=http://fs:dev-cc-token-change-me@127.0.0.1:8090/v1/fs-xml
# BasicAuth 用户固定 fs，口令须与 CC_API_TOKEN 一致。
#CC_XML_CURL_URL=

TZ=Asia/Shanghai

# 生产 WSS：wss.pem 必须按“私钥 + 完整证书链”顺序合并，文件权限 0600，
# 并放在仓库外。启用方式见 docker-compose.wss.yml 和部署文档。
#FS_WSS_PEM=/etc/go-admin-kit/freeswitch/wss.pem
