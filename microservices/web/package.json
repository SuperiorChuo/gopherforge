{
  "name": "go-admin-kit-micro-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host 0.0.0.0 --port 13200",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "lint:i18n": "node scripts/i18n/check.mjs",
    "test": "node --test --experimental-strip-types scripts/*.test.mjs",
    "cap:sync": "npx cap sync",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "test:components": "playwright test --config playwright.components.config.ts",
    "test:e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.4",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@react-three/postprocessing": "^3.2.0",
    "@reduxjs/toolkit": "^2.13.0",
    "antd": "^6.6.5",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "i18next": "^26.4.3",
    "n8ao": "^2.0.1",
    "nprogress": "^0.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.4",
    "sip.js": "^0.21.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
