# Copy to .env before running docker compose if you need local overrides.

TZ=Asia/Shanghai
APP_ENV=development
# Production enables strict config validation. Replace all local defaults below before setting APP_ENV=production.

# Host ports
GATEWAY_PORT=8000

# 网关 HTTPS 端口（websecure entrypoint，无证书时 Traefik 自签兜底）
GATEWAY_TLS_PORT=18443
# 网关层全局限流（Traefik ratelimit 令牌桶，average=每秒稳定速率，burst=突发上限）
GATEWAY_RATE_AVERAGE=100
GATEWAY_RATE_BURST=200
# Let's Encrypt 联系邮箱按域名在「系统管理 → 边缘证书」登记。
# system-service 是唯一 ACME owner，不再启用 Traefik 内建 certresolver。
# 上传大小上限（MB，默认 10）
UPLOAD_MAX_SIZE=10
FRONTEND_PORT=3000

# 边缘证书密钥库（system-service）。密钥是 base64(raw 32 bytes)：
#   openssl rand -base64 32
# 生产环境请通过容器平台的密钥注入能力提供，切勿提交到仓库或镜像。
#EDGE_CERT_CURRENT_KEY_ID=v1
#EDGE_CERT_ENCRYPTION_KEY=
# 轮换窗口可选旧 key；旧 envelope 全部重包装后移除。
#EDGE_CERT_PREVIOUS_KEY_ID=
#EDGE_CERT_PREVIOUS_ENCRYPTION_KEY=
#EDGE_CERT_WORKER_ENABLED=true
#EDGE_CERT_RENEW_BEFORE_DAYS=30
#EDGE_CERT_TASK_POLL_SECONDS=5
#EDGE_CERT_CHALLENGE_TTL_MINUTES=15
# 两阶段升级：首轮保持 false 兼容旧镜像；V2 稳定后可改 true 并重启 system 清理 legacy 明文列。
#EDGE_CERT_CLEAR_LEGACY_SECRETS=false
# 宿主侧证书目录（system 写、gateway 只读）
#EDGE_CERT_HOST_DIR=./certs

# 开放平台 Webhook：32 字节随机密钥的标准 Base64。
# 仅通过部署平台密钥注入，禁止提交真实值；留空时管理 API 返回 503 且 worker 不启动。
#WEBHOOK_ENCRYPTION_KEY=
#WEBHOOK_KEY_ID=current
#WEBHOOK_ALLOW_HTTP=false
#WEBHOOK_ALLOW_PRIVATE=false
#WEBHOOK_SCAN_INTERVAL_SECONDS=2
#WEBHOOK_BATCH_SIZE=50
#WEBHOOK_MAX_ATTEMPTS=5
#WEBHOOK_REQUEST_TIMEOUT_SECONDS=10

# Business services trust gateway-injected X-Auth-* headers, so their host
# ports bind loopback only by default. Set SERVICES_BIND_IP=0.0.0.0 ONLY if
# you understand this exposes header-forgeable endpoints to the network.
#SERVICES_BIND_IP=127.0.0.1
BACKEND_PORT=8081
AUTH_SERVICE_PORT=8082
IDENTITY_SERVICE_PORT=8083
SYSTEM_SERVICE_PORT=8084
AUDIT_SERVICE_PORT=8085
FILE_SERVICE_PORT=8086
AI_SERVICE_PORT=8087
CC_SERVICE_PORT=8089
CRM_SERVICE_PORT=8091
MP_SERVICE_PORT=8092
NATS_PORT=4222
POSTGRES_PORT=5432
REDIS_PORT=6379
PROMETHEUS_PORT=9090
GRAFANA_PORT=3003

# PostgreSQL
POSTGRES_DB=go_admin_kit
# Development default only; production must use a strong non-default password.
POSTGRES_PASSWORD=123456
POSTGRES_USER=postgres
DB_SSLMODE=disable
# 每服务连接池上限（默认 10/5）。预算口径：sum(副本数×MaxOpen) 必须
# 留在 PG max_connections 之内，调大前先核对副本布局。
#DB_MAX_OPEN_CONNS=10
#DB_MAX_IDLE_CONNS=5

# Redis
# Development can leave this empty; production must set a strong password.
REDIS_PASSWORD=
REDIS_DB=0

# AI service. Provider-agnostic: point AI_BASE_URL at any OpenAI-compatible
# endpoint (DeepSeek/Qwen/Ollama) or set AI_PROVIDER=anthropic. Empty
# AI_API_KEY leaves the service running with AI endpoints returning 503.
#AI_PROVIDER=openai
#AI_BASE_URL=
#AI_API_KEY=
#AI_CHAT_MODEL=
#AI_EMBED_MODEL=

# NATS (auth events). Compose wires services to nats://go-admin-kit-nats:4222;
# for bare-metal runs set NATS_URL=nats://localhost:4222. Empty disables events.
#NATS_URL=

# Docker socket mounted into the Traefik gateway for service discovery.
# Docker Desktop for Mac: use /var/run/docker.sock.raw (the plain socket
# denies in-container access). Linux: keep the default.
#DOCKER_SOCK=/var/run/docker.sock

# Backend
# Development default only; production requires at least 32 non-placeholder characters.
JWT_SECRET=local-dev-secret-change-me-32-chars
JWT_REFRESH_TOKEN_ROTATION=true
PASSWORD_MAX_AGE_DAYS=90
PASSWORD_HISTORY_COUNT=5
GITHUB_OAUTH_ENABLED=false
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/oauth/github/callback
WECHAT_OAUTH_ENABLED=false
WECHAT_CLIENT_ID=
WECHAT_CLIENT_SECRET=
WECHAT_REDIRECT_URI=http://localhost:8000/api/v1/oauth/wechat/callback
UPLOAD_STORAGE_TYPE=local
UPLOAD_LOCAL_PATH=./uploads
UPLOAD_PUBLIC_BASE_URL=/uploads
UPLOAD_LOCAL_URL_PREFIX=/uploads
# /uploads 签名 URL 的 HMAC 密钥；留空时回退各服务 JWT_SECRET
UPLOAD_URL_SIGN_SECRET=
# 签名 URL 有效期（秒），缺省 900
UPLOAD_URL_SIGN_TTL_SECONDS=900
# S3 兼容云通用（阿里 OSS/腾讯 COS/七牛均可）：endpoint 填云商 S3 兼容端点，
# BUCKET_LOOKUP 阿里/腾讯官方端点用 dns，MinIO/IP 端点用 path，缺省 auto
UPLOAD_S3_ENDPOINT=
UPLOAD_S3_BUCKET=
UPLOAD_S3_REGION=
UPLOAD_S3_BUCKET_LOOKUP=
UPLOAD_S3_ACCESS_KEY=
UPLOAD_S3_SECRET_KEY=
UPLOAD_S3_USE_SSL=true
UPLOAD_MINIO_ENDPOINT=go-admin-kit-minio:9000
UPLOAD_MINIO_BUCKET=go-admin-kit
UPLOAD_MINIO_REGION=us-east-1
UPLOAD_MINIO_ACCESS_KEY=minioadmin
UPLOAD_MINIO_SECRET_KEY=minioadmin
UPLOAD_MINIO_USE_SSL=false
CORS_ALLOW_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002
CORS_ALLOW_CREDENTIALS=true
METRICS_ENABLED=true

# Optional email notifications
EMAIL_NOTIFICATION_ENABLED=false
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=25
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_SENDER=
EMAIL_ALERT_RECEIVER=
EMAIL_ALERT_RECEIVERS=
EMAIL_SUBJECT_TEMPLATE=
EMAIL_BODY_TEMPLATE=
EMAIL_USE_TLS=false
EMAIL_START_TLS=false

# 告警内置引擎的额外通知渠道（可选；留空则该渠道跳过）
# 站内信：monitor → notify 服务的内部告警端点
NOTIFY_INTERNAL_BASE_URL=
NOTIFY_INTERNAL_TOKEN=
# 企业微信机器人 webhook（群机器人）
ALERT_WECOM_WEBHOOK_URL=

# Optional internal system-service API. Use a strong random value in production;
# empty keeps the internal SMS endpoint disabled.
SYSTEM_INTERNAL_TOKEN=

# Optional storage profile
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Optional monitoring profile
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# 审计日志保留策略：操作/登录日志保留天数，<=0（默认）关闭自动清理；
# 业务审计日志（audit_logs）不在自动清理范围。扫描周期默认一天，
# 可用 AUDIT_LOG_RETENTION_SCAN_INTERVAL_SECONDS 调整。
AUDIT_LOG_RETENTION_DAYS=0

# 代码生成器写入仓库（仅开发环境；默认关闭）。两项都要显式配置才会启用写入：
# 镜像内已固化一份仓库快照供预览/下载使用，写入才需要指到真实仓库根目录。
#CODEGEN_WRITE_ENABLED=false
#CODEGEN_REPO_ROOT=/absolute/path/to/gopherforge
