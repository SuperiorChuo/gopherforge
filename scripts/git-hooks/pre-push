#!/usr/bin/env bash
# CI、发版预检和 push 共用产品卫生检查器；不复制禁词、不提供跳过分支。
set -euo pipefail
# 锚定 hook 所属仓库，避免继承的 Git 环境把预检重定向到别处。
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
if [ "$#" -eq 0 ]; then
  # 兼容发版预检直接调用：检查当前提交，不从终端等待 Git 协议输入。
  exec python3 -B "$ROOT/scripts/release-hygiene.py"
fi
# Git 实际调用会传 remote 参数和四列 stdin；检查待传对象及全部新增历史，不误扫 HEAD。
exec python3 -B "$ROOT/scripts/release-hygiene.py" --pre-push
