#!/usr/bin/env bash
# pre-push 卫生门禁：推送前扫内部引用/路径形态/密钥形态/残留（与 CI hygiene job 同一套禁词）。
# CI 是事后报警（内容已短暂上过远端），本钩子把拦截提前到 push 动作本身。
# 经 core.hooksPath=scripts/git-hooks 生效；确属误报时 git push --no-verify 跳过（先想清楚）。
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

ALLOW='iploc.*_test\.go|mask_test\.go|setting_context_test\.go|^\.gitignore|docs/design/bpm-approval-flow\.md|\.github/workflows/ci\.yml|scripts/git-hooks/pre-push'
hit=0
for p in \
  'AGENTS\.md|CLAUDE\.md|CODEX_|SYNC_LOG' \
  '/www/|root@' \
  'sk-[a-zA-Z0-9]{20}|AKIA[0-9A-Z]{16}|ghp_[a-zA-Z0-9]{20}|gho_[a-zA-Z0-9]{20}|xox[bp]-' \
  'BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----$' \
  'freeswitch-cc|cc-service|crm-service|im-service|mp-service|pay-service|ticket-service|visibility-service' \
; do
  out=$(git grep -nE "$p" -- . | grep -vE "$ALLOW" || true)
  if [ -n "$out" ]; then hit=1; echo "[pre-push] 命中禁词：$p"; echo "$out" | head -8; fi
done
envs=$(git ls-files | grep -E '(^|/)\.env(\.|$)' | grep -v '\.env\.example$' || true)
[ -n "$envs" ] && { hit=1; echo "[pre-push] 跟踪了 .env："; echo "$envs"; }

if [ "$hit" != 0 ]; then
  echo "[pre-push] 拒绝推送：逐条处理后重试（误报请补白名单而不是 --no-verify）"
  exit 1
fi
exit 0
