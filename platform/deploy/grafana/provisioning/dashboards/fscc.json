      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "description": "各队列累计接通与放弃（gauge 呈现，用 increase 看窗口内增量）。",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
