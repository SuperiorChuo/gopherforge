{
  "title": "Platform Overview",
  "uid": "services-overview",
  "panels": [
    {
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(go_admin_kit_http_requests_total[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "title": "Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(rate(go_admin_kit_http_request_errors_total[1m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      }
    },
    {
      "title": "PostgreSQL Connections",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 8,
        "h": 6
      },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends",
          "legendFormat": "{{datname}}"
        }
      ]
    },
    {
      "title": "Cache Hit Ratio",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 7,
        "w": 4,
        "h": 6
      },
      "targets": [
        {
          "expr": "avg(rate(pg_stat_database_blks_hit[5m]) / (rate(pg_stat_database_blks_hit[5m]) + rate(pg_stat_database_blks_read[5m])))",
          "legendFormat": "cache"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "title": "Dead Tuples",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "pg_stat_user_tables_n_dead_tup",
          "legendFormat": "{{relname}}"
        }
      ]
    },
    {
      "title": "Go Memory (per service)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "go_admin_kit_go_memory_alloc_bytes{job=\"go-admin-kit-services\"} / 1024 / 1024",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MB"
        }
      }
    },
    {
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "expr": "go_admin_kit_go_goroutines{job=\"go-admin-kit-services\"}",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "title": "Redis Memory",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes / 1024 / 1024",
          "legendFormat": "used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MB"
        }
      }
    },
    {
      "title": "Redis Hit Rate",
      "type": "stat",
      "gridPos": {
        "x": 4,
        "y": 19,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))",
          "legendFormat": "hit rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        }
      }
    },
    {
      "title": "Redis Connected Clients",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "clients"
        }
      ]
    },
    {
      "title": "Host Disk",
      "type": "gauge",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "100 - (node_filesystem_avail_bytes{mountpoint='/'} / node_filesystem_size_bytes{mountpoint='/'} * 100)",
          "legendFormat": "used %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "title": "Host Memory",
      "type": "gauge",
      "gridPos": {
        "x": 6,
        "y": 24,
        "w": 6,
        "h": 5
      },
      "targets": [
        {
          "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
          "legendFormat": "used %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        }
      }
    },
    {
      "title": "Alerts",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "expr": "ALERTS{alertstate=\"firing\"}",
          "format": "table"
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "refresh": "10s"
}